# =============================================================
# .gitignore — نظام الحضور والغياب
# =============================================================

# ─── ملفات البيئة (حساسة — لا تُرفع أبداً) ──────────────────
.env
.env.production
.env.local
.env.*.local

# ─── قاعدة البيانات ──────────────────────────────────────────
db.sqlite3
*.sqlite3

# ─── سجلات النظام ────────────────────────────────────────────
logs/
*.log

# ─── الملفات الثابتة المجمّعة (تُولَّد عبر collectstatic) ────
staticfiles/

# ─── ملفات الوسائط المرفوعة ──────────────────────────────────
media/

# ─── البيئة الافتراضية ───────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.class
*.pyc
*.pyo
*.pyd
.Python

# ─── pytest / testing ────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
*.egg-info/

# ─── IDEs والمحررات ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── macOS ───────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ─── Windows ─────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── مسودات وملفات مؤقتة ─────────────────────────────────────
scratch/
*.bak
*.tmp

# ─── Docker ──────────────────────────────────────────────────
# docker-compose.override.yml

# ─── ملفات الإنتاج المحلية ───────────────────────────────────
# لا تُستثنى: DEPLOY.md, requirements-pythonanywhere.txt
# لا تُستثنى: config/settings_pythonanywhere.py, pythonanywhere_wsgi.py
