SECRET_KEY=pigIUJGS4Ra8xCBj-k9uJQ2KnpJ5-XSwXdAcybNXu6VX15eOWpEBRmDCFUsXCcAseK4

# وضع الانتاج — يجب أن يكون False دائماً
DEBUG=False

# استبدل yourusername باسم مستخدمك الفعلي على PythonAnywhere
